# ===== 后端环境变量（复制为 .env 后修改） =====
# 数据库连接串：必须是已安装 pgvector 扩展的 PostgreSQL 16。
# 默认指向项目根目录 docker-compose.yml 起的那个库（宿主机端口 5434，避免和本机已有 PG 撞端口）。
# 如果你自己装了 PostgreSQL（默认 5432），把 5434 改成 5432。
DATABASE_URL="postgresql://bmf:bmf_password@127.0.0.1:5434/bmf?schema=public"

# JWT 签名密钥：上线前必须换成随机长字符串（可用 openssl rand -hex 32 生成）
JWT_SECRET="please-change-me-to-a-long-random-string"
# token 有效期
JWT_EXPIRES_IN="8h"

# 服务端口
PORT=3000

# 允许跨域的前端地址，多个用英文逗号分隔
CORS_ORIGIN="http://localhost:5173"

# 超管初始账号（仅 seed 首次建库时使用，改这里不会修改已有账号密码）
SUPER_ADMIN_USERNAME="yy1"
SUPER_ADMIN_PASSWORD="yy1129273677"
