# =============================================================================
# docker compose 用的环境变量（复制为 .env 后修改；.env 不进 git）
#
#   cp .env.example .env
#   # 改掉 JWT_SECRET 和数据库密码，再 docker compose up -d --build
# =============================================================================

# ---------- 数据库 ----------
POSTGRES_USER=bmf
POSTGRES_PASSWORD=bmf_password
POSTGRES_DB=bmf

# ---------- 后端 ----------
# 必须换成长随机字符串，生成方式：openssl rand -hex 32
# 改了它所有已登录用户都会掉线，这是正常现象
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=8h

# 允许跨域的前端地址（同域部署时保持默认即可）。
# 生产环境（NODE_ENV=production）没配这一项会直接拒绝启动，这是刻意的安全检查。
CORS_ORIGIN=http://localhost:8081

# ---------- 超管初始账号（只在首次 npm run seed 时生效，改这里不会改已有密码） ----------
SUPER_ADMIN_USERNAME=yy1
SUPER_ADMIN_PASSWORD=yy1129273677
